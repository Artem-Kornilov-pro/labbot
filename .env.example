# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Уровень логов: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
# Сколько лаб может получить один пользователь
LAB_LIMIT=2
# Telegram id без лимита (через запятую), например автор бота
ADMIN_IDS=
# Заблокированные @username (через запятую) и ответ им на любое сообщение
BLOCKED_USERNAMES=
BLOCK_MSG=Доступ к боту закрыт.
# Файл базы (по умолчанию data/labbot.db)
# DB_PATH=data/labbot.db
